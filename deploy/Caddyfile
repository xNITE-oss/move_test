# Move Space — movespace.uz (Caddy reverse proxy + avtomatik HTTPS)
#
# /api, /docs        -> backend API (uvicorn 127.0.0.1:8000)
# qolgan hamma yo'l  -> statik sayt (Nuxt SPA, /var/www/movespace)

movespace.uz, www.movespace.uz {
	encode gzip

	# Backend API (adminka + sayt ma'lumotlari)
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	# API hujjatlari (Swagger)
	handle /docs* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /openapi.json {
		reverse_proxy 127.0.0.1:8000
	}

	# Sayt — statik SPA. Noma'lum yo'llar index.html'ga (client routing)
	handle {
		root * /var/www/movespace
		try_files {path} /index.html
		file_server
	}
}

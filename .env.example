# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env HECH QACHON git'ga qo'shilmasin (.gitignore ichida).

# ─────────────── LLM (Writer + Research uchun majburiy) ───────────────
# gemini    — bepul tarifi bor, kalit: aistudio.google.com (tavsiya, boshlash uchun)
# anthropic — sifati yuqori, lekin console.anthropic.com da kredit kerak
LLM_PROVIDER=gemini                 # gemini | anthropic | openai | fake

# Kalit `AQ.` bilan boshlansa — bu normal. Google 2026 yilda `AIza...` formatidan
# `AQ....` ga o'tdi; eski formatdagi kalitlar 2026-sentabrgacha o'chiriladi.
# Kod uchala autentifikatsiya usulini avtomatik sinaydi, o'zgartirish shart emas.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ─────────────── Web qidiruv (Research uchun majburiy) ───────────────
SEARCH_PROVIDER=tavily              # tavily | fake
TAVILY_API_KEY=

# ─────────────── Rasm (keyinroq) ───────────────
# Yuqoridagi GEMINI_API_KEY shu yerda ham ishlaydi — alohida kalit kerak emas.
IMAGE_PROVIDER=none                 # none | gemini | fake
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ─────────────── Audio (keyinroq) ───────────────
TTS_PROVIDER=none                   # none | elevenlabs | fake
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ─────────────── Telegram (Publisher uchun) ───────────────
# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=
# Kanal: @kanal_nomi yoki -100xxxxxxxxxx (bot kanalda admin bo'lishi shart)
TELEGRAM_CHANNEL_ID=
# Tasdiq uchun shaxsiy chat ID (@userinfobot orqali bilib olasiz)
TELEGRAM_REVIEW_CHAT_ID=

# ─────────────── Umumiy ───────────────
DRY_RUN=false                       # true — hech narsa yuborilmaydi, konsolga chiqadi
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60
# DATA_DIR=./data
